<Window x:Class="MozijegyFoglaloWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MozijegyFoglaloWpf"
        mc:Ignorable="d"
        Title="MainWindow" Height="800" Width="400">
    <Grid>
        <Border
            Background="black"
            Padding="40"
        >
            <StackPanel
                Background="White"
            >
                <TextBlock
                    Text="Mozijegy Foglaló"
                    TextAlignment="Center"
                    Margin="0,0,0,4"
                    Padding="12"
                    FontSize="20"
                    FontWeight="Bold"
                />
                <TextBlock
                    Text="Név"
                    FontSize="20"
                    Margin="20,0,20,4"
                />
                <TextBox
                    x:Name="inputName"
                    FontSize="20"
                    Margin="20,0,20,4"
                />
                <TextBlock
                    Text="Életkor"
                    FontSize="20"
                    Margin="20,0,20,4"
                />
                <TextBox
                    x:Name="inputAge"
                    FontSize="20"
                    Margin="20,0,20,4"
                />
                <TextBlock
                    Text="Film"
                    FontSize="20"
                    Margin="20,0,20,4"
                />
                <ComboBox
                    x:Name="inputCmbMovie"
                    FontSize="20"
                    Margin="20,0,20,4"
                >
                    <ComboBoxItem Content="Oppenheimer"/>
                    <ComboBoxItem Content="Dune"/>
                    <ComboBoxItem Content="Dunkirk"/>
                    <ComboBoxItem Content="All Quiet On The Western Front"/>
                </ComboBox>
                <TextBlock
                    Text="Jegytípus"
                    FontSize="20"
                    Margin="20,0,20,4"
                />
                <RadioButton
                    GroupName="ticket"
                    x:Name="inputRbNormalTicket"
                    Content="Normál Jegy - 2500 Ft"
                    FontSize="12"
                    Margin="20,0,20,4"
                />
                <RadioButton
                    GroupName="ticket"
                    x:Name="inputRbStudentTicket"
                    Content="DiákJegy - 1900 Ft"
                    FontSize="12"
                    Margin="20,0,20,4"
                />
                <RadioButton
                    GroupName="ticket"
                    x:Name="inputRbVipTicket"
                    Content="VIP Jegy - 4000 Ft"
                    FontSize="12"
                    Margin="20,0,20,4"
                />
                <TextBlock
                    Text="Jegyek száma"
                    FontSize="20"
                    Margin="20,0,20,4"
                />
                <TextBox
                    x:Name="inputTicketAmount"
                    FontSize="20"
                    Margin="20,0,20,4"
                />
                <TextBlock
                    Text="Extrák"
                    FontSize="20"
                    Margin="20,0,20,4"
                />
                <CheckBox
                    x:Name="inputChkbPopcorn"
                    Content="🍿Popcorn (+1200 Ft)"
                    FontSize="12"
                    Margin="20,0,20,4"
                />
                <CheckBox
                    x:Name="inputChkbDrink"
                    Content="🥤Üdítő (+800 Ft)"
                    FontSize="12"
                    Margin="20,0,20,4"
                />
                <CheckBox
                    x:Name="inputChkb3dGlasses"
                    Content="🕶️3D Szemüveg (+500 Ft)"
                    FontSize="12"
                    Margin="20,0,20,40"
                />
                <CheckBox
                    x:Name="inputChkbTerms"
                    Content="Elfogadom a vásárlási feltételeket"
                    FontSize="12"
                    Margin="20,0,20,40"
                />
                <Button
                    x:Name="inputBtnBooking"
                    Content="Foglalás"
                    Margin="20,0,20,0"
                    Padding="20"
                    Background="black"
                    Foreground="white"
                    Click="inputBtnBooking_Click"
                />
            </StackPanel>
        </Border>
    </Grid>
</Window>
